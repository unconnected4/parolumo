# Copy to backend/.env for local development. Never commit .env.
# Every variable the backend reads must be listed here.

APP_ENV=local                      # local | test | production
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://paralumo:paralumo@localhost:5432/paralumo
TEST_DATABASE_URL=postgresql+psycopg://paralumo:paralumo@localhost:5432/paralumo_test

# Signs session cookies / JWTs. Local value only; production value lives in the host's secret store.
AUTH_SECRET=local-dev-only-change-me

DICTIONARY_PROVIDER=fake           # fake | yandex
YANDEX_DICT_API_KEY=               # required only when DICTIONARY_PROVIDER=yandex

# Comma-separated. Leave empty locally (the Vite proxy makes it same-origin).
CORS_ORIGINS=
